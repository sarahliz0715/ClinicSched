# Copy this file to .env and fill in real values (never commit .env).

# Supabase project (Settings → API in the Supabase dashboard)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# No VITE_APP_PUBLIC_URL here on purpose — shareable open-shift and
# staff-invite links always use window.location.origin (src/lib/
# supabaseClient.js), so they're correct on whichever deployment actually
# generated them (a preview branch, production, wherever). A static env
# var previously overrode that and baked the production domain into every
# preview build's invite links — don't reintroduce one for this.

# Used by the "notify-open-shift" edge function to build its own links back
# to this app in emails (set as a Supabase secret, not here — this one is
# genuinely different: it runs server-side with no window.location to fall
# back to, so it does need an explicit value once you're ready to send
# real emails from a stable domain).
# APP_PUBLIC_URL=https://your-deployed-app.example.com

# Used by the "notify-open-shift" edge function (set as Supabase secrets,
# not here):
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Used by the "parse-schedule-photo" edge function for photo-upload OCR
# (set as a Supabase secret, not here):
# ANTHROPIC_API_KEY=
