# Copy this file to .env and fill in real values (never commit .env).

# Supabase project (Settings → API in the Supabase dashboard)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Public base URL this app is deployed at (used to build shareable open-shift
# and staff-invite links). Falls back to window.location.origin if unset.
VITE_APP_PUBLIC_URL=

# Used by the "public-open-shifts" edge function to build its own links back
# to this app in emails (set as a Supabase secret, not here).
# APP_PUBLIC_URL=https://your-deployed-app.example.com

# Used by the "notify-open-shift" edge function (set as Supabase secrets,
# not here):
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Used by the "parse-schedule-photo" edge function for photo-upload OCR
# (set as a Supabase secret, not here):
# ANTHROPIC_API_KEY=
